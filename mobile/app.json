{
  "expo": {
    "name": "Saru International",
    "slug": "saru-international",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "saru",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saruinternational.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Saru International uses the camera to scan product barcodes and capture delivery evidence.",
        "NSPhotoLibraryUsageDescription": "Saru International needs photo library access to attach document evidence."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102A43",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.saruinternational.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Saru International to scan barcodes and capture operational evidence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Saru International to update your profile photo.",
          "cameraPermission": "Allow Saru International to take a profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api",
      "enableMockApi": true,
      "appName": "Saru International",
      "apiVersion": "v1",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
