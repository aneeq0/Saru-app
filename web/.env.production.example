# Copy values into the Vercel project → Settings → Environment Variables
# (Production / Preview as needed). Do not commit real secrets here.
#
# IMPORTANT: VITE_API_BASE_URL must include https:// AND end with /api
# Bad:  saru-app-production.up.railway.app
# Bad:  https://saru-app-production.up.railway.app
# Good: https://saru-app-production.up.railway.app/api

VITE_API_BASE_URL=https://your-api.up.railway.app/api
VITE_SOCKET_URL=https://your-api.up.railway.app
VITE_ENABLE_MOCK_API=false
VITE_APP_NAME=Saru International
VITE_APP_ENV=production
