# API Configuration
# Local (mock on): relative /api is fine.
# Local (real Nest): /api via Vite proxy, or http://localhost:3000/api if CORS allows.
# Production (Vercel): absolute Railway API URL including /api prefix.
VITE_API_BASE_URL=/api

# Socket.IO origin (optional; defaults to API origin without /api).
# Production example: https://your-api.up.railway.app
# VITE_SOCKET_URL=http://localhost:3000

# Enable MSW mock API for local development without a backend.
# Defaults to true in Vite DEV and false in production builds unless set.
VITE_ENABLE_MOCK_API=true

# Application metadata
VITE_APP_NAME=Saru International
VITE_APP_ENV=development

# ─── Vercel production checklist ────────────────────────────────────────────
# VITE_API_BASE_URL=https://your-api.up.railway.app/api
# VITE_SOCKET_URL=https://your-api.up.railway.app
# VITE_ENABLE_MOCK_API=false
# VITE_APP_ENV=production
