NODE_ENV=development
PORT=3000
API_BASE_PATH=api

# Local Docker Compose (see docker-compose.yml). On Railway, use plugin-provided URLs.
DATABASE_URL=postgresql://saru:saru_dev_password@localhost:5433/saru_international?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated browser origins allowed for CORS + Socket.IO credentials.
# Local:
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Production (Vercel admin) example — replace with your real admin URL(s):
# WEB_ORIGIN=https://saru-admin.vercel.app,https://admin.your-domain.tld

MOBILE_APP_SCHEME=saru
SESSION_COOKIE_NAME=saru_session
# Local: false + SameSite=lax. Production (Vercel↔Railway cross-site): true + none
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=XSRF-TOKEN

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=saru-documents
S3_ACCESS_KEY_ID=saru_minio
S3_SECRET_ACCESS_KEY=saru_minio_secret
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug

# Realtime: Socket.IO path=/socket.io namespace=/realtime (uses REDIS_URL for multi-instance fan-out)

# ─── Railway production checklist ───────────────────────────────────────────
# NODE_ENV=production
# PORT=${{PORT}}                          # Railway injects PORT
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# WEB_ORIGIN=https://your-admin.vercel.app
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=none
# JWT_ACCESS_SECRET=<strong random>
# JWT_REFRESH_SECRET=<strong random>
# LOG_LEVEL=info
